# Copy to .env and fill in. Every value is optional: the app starts without any of
# them and tells you on the home page what is missing. The deterministic rules
# engine needs no configuration, so an empty file still gets you real settings.
#
# Only the two API keys and the fetcher URL/token are secrets. The rest are
# defaults you will rarely change, listed here so you know they exist.

# --- TMDB: title search and metadata (themoviedb.org > Settings > API) --------
TMDB_API_KEY=
TMDB_LANGUAGE=en-US
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
TMDB_POSTER_SIZE=w185
TMDB_TIMEOUT_SECONDS=10.0
# How many search hits to offer (1-20).
TMDB_MAX_RESULTS=8

# --- Google Gemini: encoding advice (AI Studio key on your GCP project) ------
# Without a key the app uses its own rules only; with one, the rules are reviewed
# and anything the model returns is validated against an allowlist before it can
# reach a command line.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SECONDS=45.0
GEMINI_MAX_OUTPUT_TOKENS=2048
# Low on purpose: this is a settings decision, not a creative writing task.
GEMINI_TEMPERATURE=0.2

# --- IMDb technical specs (optional) -----------------------------------------
# Pasting the /technical page source always works without these. If you run a
# fetcher, point the app at it and it will retrieve the page for you. The app never
# scrapes imdb.com itself.
#
# Three kinds of URL are understood, and the endpoint name tells them apart:
#   http://192.168.1.2:8191/v1        Byparr or FlareSolverr  -> POST {"cmd": "request.get", ...}
#   http://192.168.1.2:3579/content   a browserless instance  -> POST {"url": ...}
#   http://192.168.1.2:3579/unblock   browserless, stealth    -> POST {"url": ..., "content": true}
#   https://proxy.example/get         your own proxy/Worker   -> GET  ?url=...
# A bare host:port (http://192.168.1.2:3579) is treated as browserless /content.
#
# IMDb sits behind an AWS WAF that answers a fresh browser with a JavaScript challenge.
# Measured against it, FlareSolverr gets the page and browserless and Byparr do not:
#   docker run -d -p 8191:8191 ghcr.io/flaresolverr/flaresolverr
# The challenge answers itself (its script earns a token and reloads); what matters is
# that FlareSolverr keeps a browser per session, so the token survives to the next
# attempt and a retry gets the real page. Byparr speaks the same API and stays supported.
IMDB_FETCHER_URL=
# auto (default) reads the endpoint name; query, browserless or flaresolverr force one.
IMDB_FETCHER_MODE=auto
# Browserless: its TOKEN. Sent as ?token= and as Authorization: Bearer. Byparr needs no
# token; the header is still sent, for a reverse proxy in front of it.
IMDB_FETCHER_TOKEN=
# Driving a real browser is slower than a proxy fetch, and answering a challenge slower
# again: 45 suits browserless, 90 suits FlareSolverr. The browser gets 90% of this.
IMDB_FETCHER_TIMEOUT_SECONDS=20.0
# How many times a page that turns out to be a bot check is asked for again (1-6). A
# cold FlareSolverr session needed three to get past IMDb, so four is the default.
IMDB_FETCHER_ATTEMPTS=4

# --- misc --------------------------------------------------------------------
DEBUG=false
HOST=0.0.0.0
PORT=8080
# Sent on every outbound request, so an operator can identify the traffic.
USER_AGENT=graindamage/0.7 (+https://github.com/nrosier/graindamage)
# TMDB lookups, fetched IMDb pages and Gemini answers are cached this long. 0 disables.
CACHE_TTL_SECONDS=3600
