# Copy to .env and fill in. Every value is optional: the app starts without any of
# them and tells you on the home page what is missing.

# --- TMDB: title search and metadata (themoviedb.org > Settings > API) --------
TMDB_API_KEY=
TMDB_LANGUAGE=en-US

# --- Google Gemini: encoding advice (AI Studio key on your GCP project) ------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# --- IMDb technical specs (optional) -----------------------------------------
# Pasting the /technical page source always works without these. If you run a
# fetcher (proxy, browserless, cookie-bearing service), point the app at it and
# it will retrieve the page for you.
IMDB_FETCHER_URL=
IMDB_FETCHER_TOKEN=

# --- misc --------------------------------------------------------------------
DEBUG=false
PORT=8080
CACHE_TTL_SECONDS=3600
