# Copy to .env and fill in. Every value is optional: the app starts without any of
# them and tells you on the home page what is missing. The deterministic rules
# engine needs no configuration, so an empty file still gets you real settings.
#
# Only the two API keys are secrets. The rest are defaults you will rarely
# change, listed here so you know they exist.

# --- TMDB: title search and metadata (themoviedb.org > Settings > API) --------
TMDB_API_KEY=
TMDB_LANGUAGE=en-US
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
TMDB_POSTER_SIZE=w185
TMDB_TIMEOUT_SECONDS=10.0
# How many search hits to offer (1-20).
TMDB_MAX_RESULTS=8

# --- Google Gemini: encoding advice (AI Studio key on your GCP project) ------
# Without a key the app uses its own rules only; with one, the rules are reviewed
# and anything the model returns is validated against an allowlist before it can
# reach a command line.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SECONDS=45.0
GEMINI_MAX_OUTPUT_TOKENS=2048
# Low on purpose: this is a settings decision, not a creative writing task.
GEMINI_TEMPERATURE=0.2

# --- IMDb technical specs -----------------------------------------------------
# The negative format, aspect ratio and film length are what decide the grain
# settings, and they live on IMDb's /technical page. The app never requests
# imdb.com: since April 2026 a WAF there answers anything automated with a
# challenge, so the rows arrive one of two other ways.
#
#   1. Gemini is asked for them ("fetch the technical specifications of ... from
#      IMDb"). Free, instant, and cached — but it is a model recalling or
#      searching, not IMDb speaking, so the page states the confidence it
#      reported and the advice says the rows were looked up.
#   2. You paste them. Open the /technical link shown beside the film, select the
#      specifications and paste the formatted text (or the page source — both
#      parse). A paste always wins over a look-up.
#
# Let Gemini search the web for the rows rather than answer from training data.
# Grounded answers are better sourced; turn this off if the model or the key does
# not allow the tool, and the look-up falls back to a plain question by itself.
GEMINI_WEB_GROUNDING=true

# --- the media mount (read by compose, not by the app) -----------------------
# compose.yaml mounts this directory at /media, so that the command line inside the
# container has films to point at:
#
#   docker compose exec -u "$(id -u):$(id -g)" graindamage /bin/sh
#   graindamage /media/Blade.Runner.1982.2160p.mkv
MEDIA_DIR=./media

# --- misc --------------------------------------------------------------------
DEBUG=false
HOST=0.0.0.0
PORT=8080
# Sent on every outbound request, so an operator can identify the traffic.
USER_AGENT=graindamage/0.7 (+https://github.com/nrosier/graindamage)
# TMDB lookups and Gemini answers (advice and specs alike) are cached this long.
# 0 disables.
CACHE_TTL_SECONDS=3600
